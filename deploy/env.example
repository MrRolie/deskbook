# Copy to deploy/.env (ignored by git) and fill in. Never commit the real file.
DESKBOOK_DB_PASSWORD=change-me
# The address and port the page is published on. Use a private address, not 0.0.0.0.
DESKBOOK_WEB_BIND=127.0.0.1:8820
# Where the evening job writes books, its summary and the rate cache (relative to deploy/).
DESKBOOK_DATA=./data
# The host user the job writes as, so the files it writes belong to you (id -u, id -g).
DESKBOOK_UID=1000
DESKBOOK_GID=1000
