# Weekdays at 17:45 Montréal time: after the Bank of Canada's 16:30 publication, with margin for Valet's delay.
# Persistent=true runs a missed evening at the next start.
[Unit]
Description=Run the deskbook evening job on weekdays

[Timer]
OnCalendar=Mon..Fri 17:45 America/Toronto
Persistent=true

[Install]
WantedBy=timers.target
