  },
  "BD.CDN.3YR.DQ.YLD": {
   "label": "Benchmark bond yield, 3-year",
   "description": "The yield on the Government of Canada 3-year benchmark bond. This series measures the market interest rate for the Government of Canada’s 3-year bond, which serves as a reference rate for Canadian dollar-denominated debt securities.",
   "dimension": {
    "key": "d",
    "name": "Date"
   },
   "dateFormat": "daily",
   "metadata": {
    "unit": "Percent",
    "frequency": "Business daily"
   }
  },
  "BD.CDN.5YR.DQ.YLD": {
   "label": "Benchmark bond yield, 5-year",
   "description": "The yield on the Government of Canada 5-year benchmark bond. This series reports the prevailing yield for the 5-year maturity point on the Canadian government bond yield curve.",
